{
	"manifest_version": 3,
	"name": "Goredacted Extension",
	"version": "1.0",
	"description": "Uses goredacted to mask and anonymize sensitive data on pastes",
	"permissions": ["storage", "scripting"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_start"
		}
	],
	"options_page": "options.html"
}
