{
	"manifest_version": 3,
	"name": "Goredacted",
	"version": "1.0.0",
	"description": "Uses goredacted to mask and anonymize sensitive data on pastes.",
	"permissions": ["storage", "activeTab", "tabs"],
	"host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
	"background": {
		"service_worker": "background/serviceWorker.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["shared/domainRules.js", "content/content.js"],
			"run_at": "document_start"
		}
	],
	"options_page": "options/options.html",
	"action": {
		"default_title": "Goredacted",
		"default_popup": "popup/popup.html"
	}
}
